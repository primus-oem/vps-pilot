{
  "name": "vps-pilot",
  "displayName": "VPS Pilot",
  "description": "Local MCP integration for VPS Pilot",
  "version": "0.1.0",
  "publisher": "primus-oem",
  "icon": "media/pilot-logo.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/primus-oem/vps-pilot.git"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onMcpServerDefinitionProvider:vps-pilot.mcp",
    "onView:vpsPilot.inventory"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vpsPilot.refreshInventory",
        "title": "VPS Pilot: Refresh Inventory"
      },
      {
        "command": "vpsPilot.openDeploymentWorkflow",
        "title": "VPS Pilot: Plan and Approve Deployment"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vpsPilot",
          "title": "VPS Pilot",
          "icon": "media/pilot-logo.png"
        }
      ]
    },
    "views": {
      "vpsPilot": [
        {
          "id": "vpsPilot.inventory",
          "name": "Inventory",
          "icon": "media/pilot-logo.png"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vps-pilot.mcp",
        "label": "VPS Pilot"
      }
    ],
    "configuration": {
      "title": "VPS Pilot",
      "properties": {
        "vpsPilot.binaryPath": {
          "type": "string",
          "default": "vps-pilot",
          "description": "Path or executable name for the local VPS Pilot core."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/tests/serverConfiguration.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "3.9.1",
    "typescript": "^5.9.3"
  }
}
